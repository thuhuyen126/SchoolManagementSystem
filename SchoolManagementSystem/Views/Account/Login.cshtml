@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "_LayoutAccount";
    var testMode = bool.TryParse(Environment.GetEnvironmentVariable("SCHOOL_TEST_MODE"), out var testModeEnabled) && testModeEnabled;
    var testRecaptchaBypass = bool.TryParse(Environment.GetEnvironmentVariable("TEST_RECAPTCHA_BYPASS"), out var bypassEnabled) && bypassEnabled;
    var recaptchaBypass = testMode && testRecaptchaBypass;
}

@model SchoolManagementSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<h2 class="form-account-title" style="text-align: center;">Login</h2>

<div class="row">
    <div class="col-md-4 offset-md-4">
        <form method="post" class="form-account-bg-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group form-account-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-warning"></span>
            </div>

            <div class="form-group form-account-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-warning"></span>
            </div>

            @if (!recaptchaBypass)
            {
                @* BƯỚC THÊM MỚI: Hiển thị ô Google reCAPTCHA *@
                <div class="form-group form-account-group mb-3">
                    <div class="g-recaptcha" data-sitekey="@Configuration["GoogleReCAPTCHA:SiteKey"]"></div>
                    @* Dòng thông báo lỗi nếu quên tích vào Captcha *@
                    <span class="text-danger small">@Html.ValidationMessage("CaptchaError")</span>
                </div>
            }

            <div class="form-group form-account-group">
                <div class="form-check">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember Me?</label>
                </div>
                <span asp-validation-for="RememberMe" class="text-warning"></span>
            </div>

            <div class="form-group form-account-group">
                <input type="submit" value="Login" class="btn btn-success" />
                <a asp-action="RecoverPassword" class="btn btn-link">Forgot your password?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @if (!recaptchaBypass)
    {
        @* Thêm thư viện Script của Google tại đây *@
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
