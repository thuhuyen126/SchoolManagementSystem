@model SchoolManagementSystem.Models.ConfirmEmailViewModel
@{
    Layout = "_LayoutAccount";
    ViewData["Title"] = "Confirm Email";
}

<div class="container" style="padding-top: 120px; padding-bottom: 50px;">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h2>Confirm your email</h2>
            <p>Continue to confirm your email address and activate your account.</p>
            <form asp-action="ConfirmEmail" method="post">
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <button type="submit" class="btn btn-primary">Confirm email</button>
            </form>
        </div>
    </div>
</div>
