@{
    Layout = "_Dashboard";
    ViewBag.PageTitle = "Students";
    ViewBag.SubPageTitle = "Details";
}

@model SchoolManagementSystem.Models.StudentViewModel

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>
<div class="card shadow-sm border-0 mt-3">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-3 text-center mb-4 mb-md-0">
                @{
                    if (Model.ImageId != Guid.Empty)
                    {
                        <img src="http://127.0.0.1:10000/devstoreaccount1/students/@Model.ImageId"
                             alt="Profile Picture"
                             style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&background=random&color=fff&rounded=true&size=150"
                             alt="Default Profile"
                             style="width: 150px; height: 150px; border-radius: 50%; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                    }
                }
            </div>
            <div class="col-md-9">
                <h4 class="mb-3 text-primary" style="font-weight: 600;">@Model.FirstName @Model.LastName</h4>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted" data-toggle="tooltip" title="The date the student enrolled">Enrollment Date:</dt>
                    <dd class="col-sm-8 font-weight-bold">@Model.EnrollmentDate?.ToString("d")</dd>

                    <dt class="col-sm-4 text-muted" data-toggle="tooltip" title="Current status of the student">Status:</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusBadge = Model.Status.ToString() == "Pending" ? "badge bg-warning text-dark" :
                                              Model.Status.ToString() == "Active" ? "badge bg-success" : "badge bg-secondary";
                        }
                        <span class="@statusBadge">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4 text-muted" data-toggle="tooltip" title="The class the student is currently in">School Class:</dt>
                    <dd class="col-sm-8 font-weight-bold">@Model.SchoolClass?.ClassName</dd>

                    <dt class="col-sm-4 text-muted">User ID:</dt>
                    <dd class="col-sm-8 text-secondary" style="font-size: 0.9em;">@Model.UserId</dd>
                </dl>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top text-end">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Delete
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ativar tooltip
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}
