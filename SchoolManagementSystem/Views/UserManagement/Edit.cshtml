@model SchoolManagementSystem.Data.Entities.User

@{
    ViewData["Title"] = "Edit User Role";
}

<div class="container" style="margin-top: 100px; margin-bottom: 50px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-shield"></i> Change User Role</h4>
                </div>
                <div class="card-body">
                    <p><strong>User:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    
                    <hr />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Select New Role:</label>
                            <select name="roleName" class="form-select form-control-lg" asp-items="ViewBag.Roles">
                                <option value="">-- Choose a Role --</option>
                            </select>
                            <small class="text-muted">This will replace the current role of the user.</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Index1" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-warning">
                        <i class="fas fa-exclamation-triangle"></i> Caution: Changing roles may affect user access permissions.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>