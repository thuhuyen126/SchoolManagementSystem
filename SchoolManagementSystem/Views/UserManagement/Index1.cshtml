@model IEnumerable<SchoolManagementSystem.Models.UserWithRoleViewModel>

@* Bao bọc toàn bộ bằng div này *@
<div class="container-fluid" style="padding-top: 100px; padding-left: 30px; padding-right: 30px; margin-bottom: 50px;">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark" style="font-weight: 600;">User Management List</h2>
    </div>

    @* Phần bảng dữ liệu *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th class="text-center">Role</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="@(user.IsLocked ? "table-light text-muted" : "")" style="@(user.IsLocked ? "opacity: 0.7;" : "")">
                            <td class="ps-4 align-middle">
                                <span class="@(user.IsLocked ? "text-decoration-line-through" : "fw-bold")">
                                    @user.FirstName @user.LastName
                                </span>
                                
                                @if (user.IsLocked)
                                {
                                    <span class="badge bg-danger ms-2" style="font-size: 0.75rem;">
                                        <i class="fas fa-ban me-1"></i>Suspended
                                    </span>
                                }
                            </td>
                            <td class="align-middle">@user.Email</td>
                            <td class="text-center align-middle">
                                @* Thêm màu sắc cho từng Role *@
                                @{
                                    var badgeClass = user.Role switch
                                    {
                                        "Admin" => "bg-danger",
                                        "Teacher" => "bg-primary",
                                        "Student" => "bg-info text-dark",
                                        "Employee" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass" style="min-width: 80px;">@user.Role</span>
                            </td>
                            <td class="text-center align-middle pe-4">
                                <div class="btn-group shadow-sm" role="group">
                                    
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.UserId" />
                                        @if (user.IsLocked)
                                        {
                                            <button type="submit" class="btn btn-sm btn-success" title="Reactivate User">
                                                <i class="fas fa-unlock me-1"></i> Activate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Suspend User">
                                                <i class="fas fa-lock"></i>
                                            </button>
                                        }
                                    </form>

                                    @* Nút Delete (Giữ nguyên icon thùng rác đỏ) *@
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.UserId" />
                                        <button type="button" onclick="confirmDelete(this.form)" class="btn btn-sm btn-outline-danger" title="Delete User">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function confirmDelete(form) {
        Swal.fire({
            title: 'Security Verification',
            text: "You will be redirected to confirm deletion via OTP code sent to your email.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Proceed to OTP'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        })
    }
</script>
