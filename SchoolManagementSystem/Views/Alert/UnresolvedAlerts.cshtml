@{
    Layout = "_Dashboard";
    ViewBag.PageTitle = "Alerts";
    ViewBag.SubPageTitle = "Unresolved Alerts";
}

@model IEnumerable<SchoolManagementSystem.Data.Entities.Alert>

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-dark" style="font-weight: 600;">Unresolved Alerts</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success shadow-sm border-0 d-flex align-items-center" role="alert">
        <i class="fas fa-check-circle fa-2x text-success me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">All caught up!</h5>
            <p class="mb-0">Great job! There are no unresolved alerts at the moment.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Message</th>
                        <th>Created At</th>
                        <th class="text-center pe-4" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model)
                    {
                        <tr>
                            <td class="ps-4 align-middle">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                <span style="font-weight: 500;">@alert.Message</span>
                            </td>
                            <td class="align-middle text-muted">
                                <i class="far fa-clock me-1"></i> @alert.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center align-middle pe-4">
                                <button class="btn btn-sm btn-success shadow-sm w-100" onclick="markAsResolved(@alert.Id)">
                                    <i class="fas fa-check-circle me-1"></i> Mark as Resolved
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function markAsResolved(alertId) {
        Swal.fire({
        title: 'Are you sure?',
        text: "You want to mark this alert as resolved!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#198754', // Màu xanh success
        cancelButtonColor: '#6c757d', // Màu xám secondary
        confirmButtonText: '<i class="fas fa-check"></i> Yes, resolve it!',
        cancelButtonText: 'Cancel'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("MarkAsResolved", "Alert")',
        type: 'POST',
        data: { id: alertId },
        success: function () {
        Swal.fire({
        title: 'Resolved!',
        text: 'The alert has been marked as resolved.',
        icon: 'success',
        timer: 1500, // Tự động đóng sau 1.5 giây cho mượt
        showConfirmButton: false
        }).then(() => {
        location.reload();
        });
        },
        error: function () {
        Swal.fire(
        'Error!',
        'There was a problem resolving the alert.',
        'error'
        );
        }
        });
        }
        });
        }
    </script>
}